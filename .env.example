# ==============================================================================
# Japanese Places Offline Auction Management System - Environment Configuration
# ==============================================================================

# Supabase Configuration (Main Database & Image Storage)
# Found in your Supabase Project Settings > API:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET_NAME=japanese-places

# Auth Secret for JWT / Session Cookies (generate with: openssl rand -base64 32)
AUTH_SECRET=japanese_offline_auction_super_secret_jwt_key_2026_change_in_production

# Initial Secure Administrator Credentials (automatically initialized in Supabase)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
