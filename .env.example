# ==============================================================================
# Japanese Places Offline Auction Management System - Environment Configuration
# ==============================================================================

# MongoDB Atlas Connection URI (Must support multi-document transactions)
# For local replica set or Atlas cluster:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/japanese_auction?retryWrites=true&w=majority

# Auth Secret for JWT / Session Cookies (generate with: openssl rand -base64 32)
AUTH_SECRET=japanese_offline_auction_super_secret_jwt_key_2026_change_in_production

# Initial Secure Administrator Credentials (automatically initialized if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@Sakura2026!

# Supabase Storage Configuration (Used strictly for image files only)
# Leave blank or local fallback if Supabase credentials are not yet configured
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET_NAME=japanese-places

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
